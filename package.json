{
  "name": "qingyan-study-room",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:static": "vite --mode static",
    "build": "vue-tsc --noEmit && vite build",
    "build:static": "vue-tsc --noEmit && vite build --mode static",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "chat:dev": "wrangler dev --config cloudflare/chat-worker/wrangler.toml --local --port 8787",
    "chat:login": "wrangler login",
    "chat:db:create": "wrangler d1 create qingyan-chat",
    "chat:db:migrate:local": "wrangler d1 migrations apply qingyan-chat --local --config cloudflare/chat-worker/wrangler.toml",
    "chat:db:migrate": "wrangler d1 migrations apply qingyan-chat --remote --config cloudflare/chat-worker/wrangler.toml",
    "chat:deploy": "wrangler deploy --config cloudflare/chat-worker/wrangler.toml"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "lucide-vue-next": "^1.0.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "worker-mailer": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
